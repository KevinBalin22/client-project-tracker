# Base URL the browser uses to reach the API.
# The default "/api" goes through the Vite dev proxy (see vite.config.ts), so no CORS setup is needed.
# Set it to the Laravel URL directly (e.g. http://127.0.0.1:8000) when serving a production build.
VITE_API_URL=/api

# Where the Vite dev proxy forwards /api requests (read from the shell environment, not this file).
# API_PROXY_TARGET=http://127.0.0.1:8000
